# 이 파일을 `.env` 로 복사해 값을 채운다: cp .env.example .env
#
# 설정 검사(config.py) — 잘못된 설정은 기동 실패로 알려 준다(ENV=test 는 제외):
# - `.env` 가 없으면 ENV·비밀 키 3종·MYSQL_HOST/USER/PASSWORD/DATABASE 가 환경 변수로 모두
#   들어와야 한다(컨테이너 주입). 하나라도 없으면 기동하지 않는다.
# - 비밀 키 3종과 MYSQL_PASSWORD 가 아래 예시 값 그대로이거나 비어 있으면 **개발 환경에서도**
#   기동하지 않는다. 비밀 키는 32자 이상, access 와 refresh 는 서로 달라야 한다.
#   생성: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# - staging/production 은 추가로 DEBUG·CORS '*'·SQL echo·LOG_LEVEL=DEBUG 를 거부한다.
# - 예전 설정 ADMIN 이 남아 있으면 기동하지 않는다 — ADMIN_DISABLED 로 바뀌었다(아래 참조).

# =============================================================================
# 애플리케이션 설정
# =============================================================================
# 프로젝트 이름 (Scalar 문서 제목에 표시). 미설정 시 "FastAPI Project"
# PROJECT_NAME=FastAPI Project

# 애플리케이션 버전 (/health·/ready 응답과 OpenAPI 에 포함). 미설정 시 0.1.0
# VERSION=0.1.0

# 프로젝트 설명 (Scalar 문서 본문). 미설정 시 config.API_DESCRIPTION 을 쓴다.
# 지정하면 그 안내문 전체를 대체한다.
# DESCRIPTION=...

# DEBUG 모드 설정 (기본값: true)
# - true: DEBUG 로그 출력, 테이블 자동 생성, uvicorn reload 활성화, /docs 활성화
# - false: INFO 로그만 출력, 테이블 자동 생성 비활성화 (Alembic 사용), /docs 비활성화
DEBUG=true

# 관리 화면(SQLAdmin, /admin) 끄기 (기본값: false — 개발 우선 구조라 켜 둔 것이 의도된 기본값)
# - false: /admin 마운트. **활성 슈퍼유저 로그인이 필요하다**(Bootstrap 로그인 화면).
#          계정은 `uv run python -m scripts.create_superuser` 로 만든다.
# - true : /admin 이 아예 없다(404) — sqladmin·관리 세션·인증 백엔드를 만들지 않고, 앱이 내보내는
#          어떤 응답·기동 로그에도 관리 경로가 나오지 않는다. 관리 화면을 쓰지 않는 배포는 true.
# Note: DEBUG 설정과 독립적으로 동작합니다. 관리 세션(Redis) 키는 아래 SESSION_SECRET_KEY·ADMIN_SESSION_*.
# ⚠️ 예전 ADMIN(true=켬)은 이 설정으로 바뀌었고 의미가 반대다. `.env` 나 환경 변수에 ADMIN 이
#    남아 있으면 기동하지 않는다 — ADMIN=false 였다면 ADMIN_DISABLED=true, 아니면 ADMIN 줄을 지운다.
#    예전 "무인증 허용" 확인 플래그는 없어졌다(남아 있어도 무시된다 — 지워도 된다).
ADMIN_DISABLED=false

# 환경 설정: development(개발), test(테스트), staging(스테이징), production(운영)
# 로그 구성(ENV 별 핸들러·UTC)과 설정 검사 범위가 이 값을 따른다(맨 위 설명 참조).
# test 외 모든 ENV 에서 placeholder·짧은 키를, staging/production 은 추가로 DEBUG·CORS '*'·
# SQL echo·LOG_LEVEL=DEBUG 를 거부한다. staging/production 은 /admin 세션 쿠키에 Secure 를 붙인다
# (HTTPS 로만 전송 — HTTP 로 띄우면 로그인해도 쿠키가 붙지 않는다).
ENV=development

# `python main.py` 직접 실행 시 개발 서버 바인딩 호스트/포트.
# 0.0.0.0 은 컨테이너/외부 접근 허용용 기본값. 민감한 환경에서는 127.0.0.1 로 제한하고
# 리버스 프록시(nginx 등) 뒤에 두는 것을 권장한다.
#
# ⚠️ 위 ADMIN_DISABLED 와 함께 본다. 관리 화면을 켠 채(ADMIN_DISABLED=false) 0.0.0.0 으로 열면
#    /admin 로그인 화면이 네트워크에 노출된다(슈퍼유저 로그인·rate limit 으로 보호된다).
#    쓰지 않으면 ADMIN_DISABLED=true, 쓰면 프록시·방화벽으로 /admin 접근 범위를 좁히는 것을 권장한다.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================================
# 타임존 설정
# =============================================================================
# 애플리케이션 전역 타임존 — 로그 표시·리포트 영업일·Celery beat 표시에 쓴다.
# DB 저장 시각은 이 값과 무관하게 항상 UTC 다(값을 바꿔도 기존 행의 의미가 바뀌지 않는다).
# 예시: Asia/Seoul, UTC, America/New_York
TIME_ZONE=Asia/Seoul

# =============================================================================
# 데이터베이스 설정 (MySQL)
# =============================================================================
# MySQL 서버 호스트 (IP 또는 도메인)
MYSQL_HOST=localhost

# MySQL 서버 포트
MYSQL_PORT=3306

# MySQL 접속 사용자명
MYSQL_USER=root

# MySQL 접속 비밀번호 (코드 기본값은 빈 문자열 — 실제 값으로 바꾼다)
# 이 예시 값과 빈 값 모두 test 외 모든 ENV 에서 기동이 거부된다.
MYSQL_PASSWORD=your-mysql-password-change-this

# 사용할 데이터베이스 이름
MYSQL_DATABASE=fastapi_db

# =============================================================================
# DB 라우터 (읽기/쓰기 분리)
# =============================================================================
# 라우터 사용 여부 (기본값: false)
# - false: 모든 쿼리가 위에서 설정한 단일 서버로 나간다 (기존 동작)
# - true : 세션이 구문 성격에 따라 엔진을 자동 선택한다
#          · ORM flush / INSERT·UPDATE·DELETE → primary(쓰기)
#          · SELECT                            → replica(읽기)
#          · 쓰기가 일어난 세션의 이후 SELECT  → primary 고정 (아래 STICKY 참고)
# 구현: app/core/db/router.py
DB_ROUTER_ENABLED=false

# 읽기 복제본(replication) 사용 여부 (기본값: false)
# - true 로 켜려면 DB_ROUTER_ENABLED=true 와 MYSQL_REPLICA_HOSTS 지정이 함께 필요하다.
#   (모순된 조합은 애플리케이션 기동 시점에 에러로 차단된다)
# - false: 라우터를 켜도 replica 가 없으므로 읽기도 primary 로 나간다.
DB_REPLICATION_ENABLED=false

# 쓰기 이후 같은 세션의 읽기를 primary 에 고정 (기본값: true, 권장)
# 복제 지연(replication lag) 때문에 방금 커밋한 행이 replica 에서 아직 안 보일 수 있다.
# false 로 두면 읽기 분산은 늘어나지만 read-after-write 일관성을 잃는다.
DB_READ_STICKY_AFTER_WRITE=true

# replica 호스트 목록 (JSON 배열, "host" 또는 "host:port" 형식)
# 여러 대를 지정하면 세션 단위 라운드로빈으로 분산된다.
# 호스트는 IP 주소와 도메인 이름을 모두 쓸 수 있고, 포트를 생략하면 MYSQL_REPLICA_PORT 를 쓴다.
#   IPv4   : ["10.0.0.11", "10.0.0.12:3307"]
#   도메인 : ["replica-a.example.com", "replica-b.example.com:3307"]
#   IPv6   : ["[2001:db8::10]:3307", "[::1]"]   ← 반드시 대괄호로 감쌀 것
# 예: MYSQL_REPLICA_HOSTS=["10.0.0.11", "replica-b.example.com:3307"]
MYSQL_REPLICA_HOSTS=[]

# 포트를 명시하지 않은 replica 에 적용할 기본 포트
MYSQL_REPLICA_PORT=3306

# replica 전용 자격증명 (비워두면 위 primary 값을 그대로 재사용)
# 읽기 전용 계정을 따로 두면 실수로 replica 에 쓰는 사고를 DB 권한으로 막을 수 있다.
# MYSQL_REPLICA_USER=readonly
# MYSQL_REPLICA_PASSWORD=change-this-replica-password
# MYSQL_REPLICA_DATABASE=fastapi_db

# =============================================================================
# 마이그레이션 (Alembic)
# =============================================================================
# Alembic 이 사용할 DSN. 미설정 시 위 primary 설정에서 자동 유도한다
# (드라이버만 동기용 pymysql 로 치환 — Alembic 은 비동기 드라이버를 쓸 수 없다).
# 로컬/CI 에서 SQLite 등으로 갈아끼울 때만 명시한다.
# 마이그레이션은 항상 primary 에서 실행된다 (replica 는 읽기 전용).
# ALEMBIC_DATABASE_URL=sqlite:///./test.db

# =============================================================================
# Redis 설정 — 기동 시 ping()·버전(7.0 이상, EXPIRE ... NX) 필수 검증, refresh 토큰 저장소·
# 로그인 rate limit, Celery broker/backend (캐시·세션 저장 용도의 코드는 없다)
# =============================================================================
# Redis 서버 호스트
REDIS_HOST=localhost

# Redis 서버 포트
REDIS_PORT=6379

# Redis 데이터베이스 번호 (0-15)
REDIS_DB=0

# Redis 비밀번호 (설정하지 않으면 인증 없이 접속)
REDIS_PASSWORD=

# =============================================================================
# CORS 설정 (Cross-Origin Resource Sharing)
# =============================================================================
# 허용할 Origin 목록 (JSON 배열 형식)
# 모든 Origin 허용: ["*"]
# 특정 Origin만 허용: ["http://localhost:3000", "https://example.com"]
CORS_ALLOW_ORIGINS=["*"]

# 자격 증명(쿠키, Authorization 헤더) 허용 여부
CORS_ALLOW_CREDENTIALS=false

# 허용할 HTTP 메서드 (JSON 배열 형식, 미설정 시 ["*"])
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]

# 허용할 HTTP 헤더 (JSON 배열 형식)
CORS_ALLOW_HEADERS=["*"]

# 브라우저(JS)에 노출할 응답 헤더 (JSON 배열 형식)
# CORS_EXPOSE_HEADERS=["X-Total-Count"]

# Preflight 요청 캐시 시간 (초)
CORS_MAX_AGE=600

# =============================================================================
# 로깅 설정
# =============================================================================
# 콘솔 로그 출력 활성화
# false 면 콘솔(stdout/stderr) 핸들러를 하나도 붙이지 않는다 — 앱 로그·uvicorn(python main.py 와
# uvicorn main:app 둘 다)·Celery 워커 모두. 파일 핸들러가 있으면(staging/production + LOG_FILE_ENABLED)
# 로그는 파일에만 남고, 파일도 없으면 기동은 하되 시작 시 stderr 에 경고 한 줄을 남긴다.
# 예: 컨테이너에서 파일만 수집할 때 ENV=production, LOG_FILE_ENABLED=true, LOG_CONSOLE_ENABLED=false
LOG_CONSOLE_ENABLED=true

# 파일 로그 출력 활성화 — ENV=staging/production 일 때만 파일 핸들러를 붙인다
LOG_FILE_ENABLED=true

# SQL/드라이버 DEBUG·INFO 로그 허용 (development/test 전용)
#
# 기본 false. SQLAlchemy 의 echo 계열 로그는 SQL 본문과 **바인딩된 파라미터**를 그대로
# 찍는다 — 사용자 식별자·검색어·이메일이 로그 파일에 남는다.
# staging/production 에서 true 로 두면 기동이 실패한다(의도된 동작).
LOG_SQL_ECHO_ENABLED=false

# 로그 레벨 설정 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# 미설정 시 DEBUG 설정에 따라 자동 결정:
#   - DEBUG=true → DEBUG 레벨
#   - DEBUG=false → INFO 레벨
# 명시적 설정 시 해당 값이 우선 적용됨
# LOG_LEVEL=DEBUG
# LOG_CONSOLE_LEVEL=DEBUG

# 헤더(app=)별 최소 레벨 — Django LOGGING["loggers"][이름]["level"] 자리 (빈 값 = 모두 LOG_LEVEL)
# 키는 헤더 이름: 기능명(blog·user…)·core·celery·utils·migrations·app·uvicorn·sqlalchemy·alembic·ext
# 값은 DEBUG/INFO/WARNING/ERROR/CRITICAL. 잘못된 형식·레벨은 기동 오류, 모르는 헤더는 경고만 한다.
# 콘솔·파일 레벨(LOG_CONSOLE_LEVEL·LOG_FILE_LEVEL)은 출력처 하한으로 그대로 적용된다.
# 예: LOG_APP_LEVELS=blog=DEBUG,celery=INFO,sqlalchemy=WARNING
LOG_APP_LEVELS=

# 파일 로그 레벨 (파일에는 INFO 이상만 기록하는 것이 일반적)
LOG_FILE_LEVEL=INFO

# 로그 파일 저장 디렉토리 (프로젝트 루트 기준 상대 경로)
# 파일: 웹 app.log·error.log, Celery 워커 celery.log·celery-error.log (에러 파일은 ERROR 이상)
LOG_DIR=logs

# 매일 UTC 자정에 app.log → app.log.YYYY-MM-DD 로 교체한다.
# 하루 안에서 이 크기(MB)를 넘으면 app.log.YYYY-MM-DD.1, .2 … 로 나눈다. 0 = 나누지 않음
LOG_MAX_SIZE_MB=10

# 교체된 파일 보관 일수 — 교체 시점에 이보다 오래된 날짜 파일(분할 파일 포함)을 지운다.
# 0 = 지우지 않음, 음수는 기동 오류. (예전 LOG_BACKUP_COUNT·LOG_APP_FILENAME·LOG_ERROR_FILENAME 은
# 지웠다 — 남아 있어도 무시된다.)
# 여러 프로세스가 같은 파일을 쓰면(uvicorn --workers 2 이상, Celery prefork 동시성 2 이상)
# 회전이 안전하지 않다 — 그때는 LOG_FILE_ENABLED=false 로 두고 stdout 을 수집기/logrotate 로 보낸다.
LOG_RETENTION_DAYS=30

# 로그 출력 형식 (str.format 의 {필드} 형식, 아래 값이 기본값)
# 쓸 수 있는 필드: LogRecord 필드(asctime·levelname·name·module·funcName·lineno·message 등)
#   + tzname(KST/UTC) · appname(헤더 — 기능명·core·celery·uvicorn 등) · classname(호출 클래스, 없으면 -)
# 필수 필드: {asctime} {levelname} {appname} {module} {classname} {funcName} {message}
#   하나라도 빠지면 기동 시 설정 오류로 멈춘다(빠진 필드를 알려 준다).
# LOG_CONSOLE_FORMAT: 콘솔 줄 형식 — 모든 경로(앱·python main.py·uvicorn main:app·Celery 워커)가 쓴다.
#   uvicorn 접속 줄은 {message} 가 요청 줄(client - "GET /p HTTP/1.1" 200)이다.
# LOG_FILE_FORMAT: 파일 줄 형식 — app·error·celery 파일과 Celery --logfile
# 모르는 필드({foo})·괄호 불일치·잘못된 지정자는 기동 시 설정 오류로 멈춘다.
# 비밀값 마스킹(DSN 사용자명·비밀번호, token= 등, 설정된 비밀값 원문)은 형식과 무관하게 적용된다.
# 예: LOG_CONSOLE_FORMAT={asctime} {levelname} {appname} {module}.{classname}.{funcName} {message}
# LOG_CONSOLE_FORMAT=[{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
# LOG_FILE_FORMAT=[{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
#
# {asctime} 의 날짜 형식 (strftime). development 에서는 끝에 .밀리초 가 붙는다. 빈 값은 설정 오류.
# 예: LOG_DATE_FORMAT=%H:%M:%S
# LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# =============================================================================
# 미들웨어 설정
# =============================================================================
# 접속 로그 수집 활성화
# true: 모든 API 요청에 대해 접속 로그를 DB에 저장
ACCESS_LOG_ENABLED=true

# 앱 앞에 둔 신뢰 리버스 프록시의 수 (0 이상 정수)
#
# ⚠️ [배포 전 확인] 프록시(로드밸런서·nginx 등) 뒤에 배포하면 앞단 프록시 단 수로 설정한다.
#    0 이면 모든 클라이언트가 프록시 IP 하나로 보여 접속 로그와 로그인 rate limit(API·/admin)이
#    전체 사용자를 한 사람으로 취급한다. 실제보다 크게 잡으면 클라이언트가 IP 를 위조할 수 있다.
#
# 기본값 0 이 안전한 쪽이다 — 전달 헤더(X-Forwarded-For / X-Real-IP)를 보지 않고 직접
# 연결 주소를 쓴다. 이 헤더는 클라이언트가 임의로 보낼 수 있어서, 프록시 뒤가 아닌데
# 신뢰하면 아무나 헤더 한 줄로 접속 로그의 IP 를 위조하고 IP 기반 조회
# (/api/v1/home/access-logs/by-ip/...)를 오염시킬 수 있다.
# N 이면 X-Forwarded-For 의 오른쪽에서 N번째(우리 프록시가 붙인 값)를 쓴다. 프록시 하나
# (nginx 등) 뒤면 1. XFF 가 없으면 X-Real-IP, 값이 IP 가 아니면 직접 연결 주소.
# 예전 bool 설정(신뢰 여부 true/false)을 대체한다 — true 였다면 프록시 수(보통 1)로 옮긴다.
TRUSTED_PROXY_HOPS=0

# 접속 로그 보존 일수 (0 이상 정수, 기본 365 = 1년)
# 이보다 오래된 접속 로그는 Celery beat 가 매일 03:30(TIME_ZONE 기준)에 5,000행씩 나눠 지운다.
# 0 = 삭제하지 않음(무기한 보존). 음수는 기동 시 설정 오류. beat 를 띄우지 않으면 지워지지 않는다.
ACCESS_LOG_RETENTION_DAYS=365

# 접속 로그 query_string 에서 값을 *** 로 가릴 키 (JSON 배열, 대소문자 무시)
# 미설정 시 ["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]
# ACCESS_LOG_SENSITIVE_QUERY_KEYS=["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]

# 접속 로그 수집 제외 경로 (JSON 배열 형식)
# 미설정 시 ["/health", "/docs", "/redoc", "/openapi.json", "/favicon.ico"]
# ACCESS_LOG_EXCLUDE_PATHS=["/health", "/docs", "/openapi.json", "/admin"]

# 접속 로그 수집 제외 확장자 (JSON 배열 형식)
# 미설정 시 [".css", ".js", ".ico", ".png", ".jpg", ".jpeg", ".gif", ".svg"]
# ACCESS_LOG_EXCLUDE_EXTENSIONS=[".css", ".js", ".ico", ".png", ".jpg"]

# =============================================================================
# 세션 설정
# config.SessionSettings 로 로드됨. API 인증은 JWT(Bearer) 이고 쿠키 세션은 /admin 로그인만
# 쓴다(쿠키 이름 admin_session, Path=/admin — docs/guides/admin-auth-guide.html).
# =============================================================================
# 세션 쿠키 이름 — 접속 로그의 session_id 가 이 이름의 쿠키를 읽는다(기록용, 인증에 쓰지 않는다).
# /admin 세션 쿠키(admin_session)와는 별개다.
SESSION_COOKIE_NAME=session

# 세션 키 (보안을 위해 반드시 변경 필요) — /admin 관리 세션의 Redis 키를 만든다
# (admin:sess:{HMAC-SHA256(이 키, 세션 ID)} — 쿠키에는 무작위 세션 ID 만 있다).
# 바꾸면 기존 /admin 로그인 세션이 모두 끊긴다(다시 로그인).
# ⚠️ test 외 모든 ENV 는 placeholder 키로 기동하지 않는다(config.is_placeholder_secret):
#    앞뒤 공백 제거·소문자화 후 'change-this' 포함, 'your-' 로 시작, 또는 빈 값이면 거부. 32자 미만도 거부.
#    아래 예시 값은 일부러 그 규칙에 걸리게 두었다 — 세 키 모두 서로 다른 실제 값으로 바꾼다.
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-this-session-secret-key

# /admin 관리 세션 절대 만료 (초, 기본값: 28800 = 8시간, 최소 60) — 로그인 시각부터 세고 연장되지 않는다.
# 쿠키 Max-Age 도 이 값이다.
# ADMIN_SESSION_MAX_AGE_SECONDS=28800

# /admin 관리 세션 미사용 만료 (초, 기본값: 1800 = 30분, 최소 60, 절대 만료 이하) —
# 요청이 올 때마다 Redis TTL 을 이 값으로 다시 맞춘다(절대 만료를 넘지 않게).
# ADMIN_SESSION_IDLE_SECONDS=1800

# =============================================================================
# JWT 토큰 설정
# ✅ 인증(app/features/auth)에서 사용됨 — config.JWTSettings 로 로드. 운영 시 키를 교체하세요.
# =============================================================================
# Access Token 서명 키 (보안을 위해 반드시 변경 필요)
# placeholder 규칙은 위 SESSION_SECRET_KEY 주석과 같다.
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET_KEY=change-this-access-token-secret-key

# Refresh Token 서명 키 (Access Token 과 달라야 한다 — 같으면 배포 게이트가 거부)
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
REFRESH_TOKEN_SECRET_KEY=change-this-refresh-token-secret-key

# Access Token 만료 시간 (분, 기본값: 15분)
# access 토큰은 만료 전 폐기 수단이 없다 — 로그아웃·재사용 탐지는 refresh 만 끊는다. 짧게 둔다.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token 만료 시간 (일, 기본값: 7일). Redis 의 refresh 기록 TTL 도 같다.
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 알고리즘 — HS256 / HS384 / HS512 만 허용 (기본값: HS256)
# JWT_ALGORITHM=HS256

# 발급자(iss)·대상(aud) claim. 검증 시 둘 다 일치해야 한다.
# 같은 서명 키를 쓰는 다른 서비스가 있으면 서비스마다 다르게 둔다.
# JWT_ISSUER=fastapi-project-structure
# JWT_AUDIENCE=fastapi-project-structure-api

# exp·nbf·iat 검증의 시계 오차 허용 (초, 기본값: 10)
# JWT_LEEWAY_SECONDS=10

# =============================================================================
# 로그인·가입 rate limit (Redis 고정 창)
# 초과하면 429 + Retry-After. /admin 로그인도 같은 한도를 쓰되 키를 따로 센다(admin:rl:).
# 클라이언트 IP 는 TRUSTED_PROXY_HOPS 로 판정한다 —
# 프록시 뒤에서 0 으로 두면 모든 사용자가 프록시 IP 하나를 공유해 함께 막힌다.
# =============================================================================
# 창(AUTH_LOGIN_WINDOW_SECONDS) 안에서 IP+사용자명 기준 로그인 시도 수 (기본값: 5). 성공하면 초기화.
# AUTH_LOGIN_MAX_ATTEMPTS=5
# 창 안에서 IP 기준 로그인 시도 수 (기본값: 20)
# AUTH_LOGIN_IP_MAX_ATTEMPTS=20
# 로그인 창 길이 (초, 기본값: 60)
# AUTH_LOGIN_WINDOW_SECONDS=60
# 창 안에서 IP 기준 가입 시도 수 (기본값: 5)
# AUTH_REGISTER_MAX_ATTEMPTS=5
# 가입 창 길이 (초, 기본값: 3600)
# AUTH_REGISTER_WINDOW_SECONDS=3600
