# =============================================================================
# 애플리케이션 설정
# =============================================================================
# 프로젝트 이름 (Scalar 문서 제목에 표시). 미설정 시 "FastAPI Project"
# PROJECT_NAME=FastAPI Project

# 애플리케이션 버전 (/health·/ready 응답과 OpenAPI 에 포함). 미설정 시 0.1.0
# VERSION=0.1.0

# 프로젝트 설명 (Scalar 문서 본문). 미설정 시 config.API_DESCRIPTION 을 쓴다.
# 지정하면 그 안내문 전체를 대체한다.
# DESCRIPTION=...

# DEBUG 모드 설정 (기본값: true)
# - true: DEBUG 로그 출력, 테이블 자동 생성, uvicorn reload 활성화, /docs 활성화
# - false: INFO 로그만 출력, 테이블 자동 생성 비활성화 (Alembic 사용), /docs 비활성화
DEBUG=true

# ADMIN 페이지 설정 (기본값: true — 개발 우선 구조라 의도된 기본값)
# - true: /admin 관리자 페이지 마운트 (SQLAdmin)
# - false: /admin 이 존재하지 않음 (404)
# Note: DEBUG 설정과 독립적으로 동작합니다.
#
# ⚠️ 이 프로젝트의 /admin 에는 인증이 없습니다(로그인 화면 없음, 영구 비목표).
#    true 로 두면 자격증명 없이 사용자·게시글·접속로그의 조회·수정·삭제와
#    CSV 내보내기가 가능합니다. 운영·스테이징은 false 로 두거나 프록시에서 막으세요.
ADMIN=true

# 환경 설정: development(개발), test(테스트), staging(스테이징), production(운영)
# 로그 구성(ENV 별 핸들러·UTC)과 배포 안전 게이트가 이 값을 따른다.
# staging/production 이면 DEBUG·ADMIN·placeholder 키·CORS '*'·SQL echo 를 거부한다.
ENV=development

# `python main.py` 직접 실행 시 개발 서버 바인딩 호스트/포트.
# 0.0.0.0 은 컨테이너/외부 접근 허용용 기본값. 민감한 환경에서는 127.0.0.1 로 제한하고
# 리버스 프록시(nginx 등) 뒤에 두는 것을 권장한다.
#
# ⚠️ 위 ADMIN 과 곱해진다. ADMIN=true + SERVER_HOST=0.0.0.0 이면
#    인증 없는 관리 화면이 네트워크에 열린다. 둘 다 기본값이므로, 아무것도
#    설정하지 않은 배포가 정확히 그 상태다. 앱은 이 조합을 막지 않는다(의도된 정책).
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================================
# 타임존 설정
# =============================================================================
# 애플리케이션 전역 타임존 (로그 시간, 데이터 생성 시간 등에 적용)
# 예시: Asia/Seoul, UTC, America/New_York
TIME_ZONE=Asia/Seoul

# =============================================================================
# 데이터베이스 설정 (MySQL)
# =============================================================================
# MySQL 서버 호스트 (IP 또는 도메인)
MYSQL_HOST=localhost

# MySQL 서버 포트
MYSQL_PORT=3306

# MySQL 접속 사용자명
MYSQL_USER=root

# MySQL 접속 비밀번호 (코드 기본값은 빈 문자열 — 실제 값으로 바꾼다)
# 이 예시 값과 빈 값 모두 staging/production 기동이 거부된다.
MYSQL_PASSWORD=your-mysql-password-change-this

# 사용할 데이터베이스 이름
MYSQL_DATABASE=fastapi_db

# =============================================================================
# DB 라우터 (읽기/쓰기 분리)
# =============================================================================
# 라우터 사용 여부 (기본값: false)
# - false: 모든 쿼리가 위에서 설정한 단일 서버로 나간다 (기존 동작)
# - true : 세션이 구문 성격에 따라 엔진을 자동 선택한다
#          · ORM flush / INSERT·UPDATE·DELETE → primary(쓰기)
#          · SELECT                            → replica(읽기)
#          · 쓰기가 일어난 세션의 이후 SELECT  → primary 고정 (아래 STICKY 참고)
# 구현: app/core/db/router.py
DB_ROUTER_ENABLED=false

# 읽기 복제본(replication) 사용 여부 (기본값: false)
# - true 로 켜려면 DB_ROUTER_ENABLED=true 와 MYSQL_REPLICA_HOSTS 지정이 함께 필요하다.
#   (모순된 조합은 애플리케이션 기동 시점에 에러로 차단된다)
# - false: 라우터를 켜도 replica 가 없으므로 읽기도 primary 로 나간다.
DB_REPLICATION_ENABLED=false

# 쓰기 이후 같은 세션의 읽기를 primary 에 고정 (기본값: true, 권장)
# 복제 지연(replication lag) 때문에 방금 커밋한 행이 replica 에서 아직 안 보일 수 있다.
# false 로 두면 읽기 분산은 늘어나지만 read-after-write 일관성을 잃는다.
DB_READ_STICKY_AFTER_WRITE=true

# replica 호스트 목록 (JSON 배열, "host" 또는 "host:port" 형식)
# 여러 대를 지정하면 세션 단위 라운드로빈으로 분산된다.
# 호스트는 IP 주소와 도메인 이름을 모두 쓸 수 있고, 포트를 생략하면 MYSQL_REPLICA_PORT 를 쓴다.
#   IPv4   : ["10.0.0.11", "10.0.0.12:3307"]
#   도메인 : ["replica-a.example.com", "replica-b.example.com:3307"]
#   IPv6   : ["[2001:db8::10]:3307", "[::1]"]   ← 반드시 대괄호로 감쌀 것
# 예: MYSQL_REPLICA_HOSTS=["10.0.0.11", "replica-b.example.com:3307"]
MYSQL_REPLICA_HOSTS=[]

# 포트를 명시하지 않은 replica 에 적용할 기본 포트
MYSQL_REPLICA_PORT=3306

# replica 전용 자격증명 (비워두면 위 primary 값을 그대로 재사용)
# 읽기 전용 계정을 따로 두면 실수로 replica 에 쓰는 사고를 DB 권한으로 막을 수 있다.
# MYSQL_REPLICA_USER=readonly
# MYSQL_REPLICA_PASSWORD=readonly_password
# MYSQL_REPLICA_DATABASE=fastapi_db

# =============================================================================
# 마이그레이션 (Alembic)
# =============================================================================
# Alembic 이 사용할 DSN. 미설정 시 위 primary 설정에서 자동 유도한다
# (드라이버만 동기용 pymysql 로 치환 — Alembic 은 비동기 드라이버를 쓸 수 없다).
# 로컬/CI 에서 SQLite 등으로 갈아끼울 때만 명시한다.
# 마이그레이션은 항상 primary 에서 실행된다 (replica 는 읽기 전용).
# ALEMBIC_DATABASE_URL=sqlite:///./test.db

# =============================================================================
# Redis 설정 — 기동 시 ping() 필수 검증, Celery broker/backend
# (캐시·세션 저장 용도의 코드는 없다)
# =============================================================================
# Redis 서버 호스트
REDIS_HOST=localhost

# Redis 서버 포트
REDIS_PORT=6379

# Redis 데이터베이스 번호 (0-15)
REDIS_DB=0

# Redis 비밀번호 (설정하지 않으면 인증 없이 접속)
REDIS_PASSWORD=

# =============================================================================
# CORS 설정 (Cross-Origin Resource Sharing)
# =============================================================================
# 허용할 Origin 목록 (JSON 배열 형식)
# 모든 Origin 허용: ["*"]
# 특정 Origin만 허용: ["http://localhost:3000", "https://example.com"]
CORS_ALLOW_ORIGINS=["*"]

# 자격 증명(쿠키, Authorization 헤더) 허용 여부
CORS_ALLOW_CREDENTIALS=false

# 허용할 HTTP 메서드 (JSON 배열 형식, 미설정 시 ["*"])
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]

# 허용할 HTTP 헤더 (JSON 배열 형식)
CORS_ALLOW_HEADERS=["*"]

# 브라우저(JS)에 노출할 응답 헤더 (JSON 배열 형식)
# CORS_EXPOSE_HEADERS=["X-Total-Count"]

# Preflight 요청 캐시 시간 (초)
CORS_MAX_AGE=600

# =============================================================================
# 로깅 설정
# =============================================================================
# 콘솔 로그 출력 활성화 — 현재 로깅 구성이 읽지 않는다(콘솔 핸들러는 항상 붙는다)
LOG_CONSOLE_ENABLED=true

# 파일 로그 출력 활성화 — ENV=staging/production 일 때만 파일 핸들러를 붙인다
LOG_FILE_ENABLED=true

# SQL/드라이버 DEBUG·INFO 로그 허용 (development/test 전용)
#
# 기본 false. SQLAlchemy 의 echo 계열 로그는 SQL 본문과 **바인딩된 파라미터**를 그대로
# 찍는다 — 사용자 식별자·검색어·이메일이 로그 파일에 남는다.
# staging/production 에서 true 로 두면 기동이 실패한다(의도된 동작).
LOG_SQL_ECHO_ENABLED=false

# 로그 레벨 설정 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# 미설정 시 DEBUG 설정에 따라 자동 결정:
#   - DEBUG=true → DEBUG 레벨
#   - DEBUG=false → INFO 레벨
# 명시적 설정 시 해당 값이 우선 적용됨
# LOG_LEVEL=DEBUG
# LOG_CONSOLE_LEVEL=DEBUG

# 파일 로그 레벨 (파일에는 INFO 이상만 기록하는 것이 일반적)
LOG_FILE_LEVEL=INFO

# 로그 파일 저장 디렉토리 (프로젝트 루트 기준 상대 경로)
LOG_DIR=logs

# 단일 로그 파일 최대 크기 (MB)
# 초과 시 자동으로 새 파일 생성 (RotatingFileHandler)
LOG_MAX_SIZE_MB=10

# 보관할 백업 로그 파일 개수
LOG_BACKUP_COUNT=5

# 로그 파일명 패턴 ({date} 는 YYYY-MM-DD 로 치환)
# LOG_APP_FILENAME={date}_app.log
# LOG_ERROR_FILENAME={date}_error.log

# 로그 출력 형식 — 현재 로깅 구성이 읽지 않는다. 실제 형식은
# app/utils/logs/config.py 의 LOG_FORMAT 하나다.
# LOG_CONSOLE_FORMAT=[{asctime}] {levelname:8} [{name}:{funcName}:{lineno}] {message}
# LOG_FILE_FORMAT=[{asctime}] {levelname:8} [{name}:{funcName}:{lineno}] {message}
# LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# =============================================================================
# 미들웨어 설정
# =============================================================================
# 접속 로그 수집 활성화
# true: 모든 API 요청에 대해 접속 로그를 DB에 저장
ACCESS_LOG_ENABLED=true

# 전달 헤더(X-Forwarded-For / X-Real-IP)를 접속 IP 로 신뢰할지
#
# 기본값 false 가 안전한 쪽이다. 이 헤더는 클라이언트가 임의로 보낼 수 있어서,
# 리버스 프록시 뒤가 아닌데 신뢰하면 아무나 헤더 한 줄로 접속 로그의 IP 를 위조하고
# IP 기반 조회(/api/v1/home/access-logs/by-ip/...)를 오염시킬 수 있다.
# 프록시가 헤더를 덮어써 주는 배포에서만 true 로 켠다.
TRUST_PROXY_HEADERS=false

# 접속 로그 수집 제외 경로 (JSON 배열 형식)
# 미설정 시 ["/health", "/docs", "/redoc", "/openapi.json", "/favicon.ico"]
# ACCESS_LOG_EXCLUDE_PATHS=["/health", "/docs", "/openapi.json", "/admin"]

# 접속 로그 수집 제외 확장자 (JSON 배열 형식)
# 미설정 시 [".css", ".js", ".ico", ".png", ".jpg", ".jpeg", ".gif", ".svg"]
# ACCESS_LOG_EXCLUDE_EXTENSIONS=[".css", ".js", ".ico", ".png", ".jpg"]

# =============================================================================
# API 설정
# =============================================================================
# REST API 버전 — 선언만 있고 URL prefix 에는 쓰이지 않는다
# (prefix 는 각 앱 router.py 의 "/v1/..." 가 정한다)
API_VERSION=v1

# =============================================================================
# 세션 설정
# config.SessionSettings 로 로드됨. 현재 인증은 JWT(Bearer) 기반이라 쿠키 세션을 쓰는
# 코드는 없다. 쿠키 세션 도입 시 `from config import session_settings` 로 사용한다.
# =============================================================================
# 세션 쿠키 이름 — 현재 미사용 (접속 로그는 `session_id` 쿠키를 코드에 고정해 읽는다)
SESSION_COOKIE_NAME=session

# 세션 암호화 키 (보안을 위해 반드시 변경 필요)
# ⚠️ ENV=staging/production 은 placeholder 키로 기동하지 않는다(config.is_placeholder_secret):
#    앞뒤 공백 제거·소문자화 후 'change-this' 포함, 'your-' 로 시작, 또는 빈 값이면 거부.
#    아래 예시 값은 일부러 그 규칙에 걸리게 두었다 — 세 키 모두 서로 다른 실제 값으로 바꾼다.
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=change-this-session-secret-key

# 세션 만료 시간 (초, 기본값: 86400 = 24시간)
# SESSION_EXPIRE_SECONDS=86400

# =============================================================================
# JWT 토큰 설정
# ✅ 인증(app/features/auth)에서 사용됨 — config.JWTSettings 로 로드. 운영 시 키를 교체하세요.
# =============================================================================
# Access Token 서명 키 (보안을 위해 반드시 변경 필요)
# placeholder 규칙은 위 SESSION_SECRET_KEY 주석과 같다.
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET_KEY=change-this-access-token-secret-key

# Refresh Token 서명 키 (Access Token 과 달라야 한다 — 같으면 배포 게이트가 거부)
# 생성 방법: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
REFRESH_TOKEN_SECRET_KEY=change-this-refresh-token-secret-key

# Access Token 만료 시간 (분, 기본값: 30분)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token 만료 시간 (일, 기본값: 7일)
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 알고리즘 (기본값: HS256)
# JWT_ALGORITHM=HS256

# =============================================================================
# SMTP 이메일 설정
# config.SMTPSettings 로 로드됨. 이메일 발송 모듈은 아직 없다 —
# 구현 시 `from config import smtp_settings` 로 사용한다.
# =============================================================================
# SMTP 서버 주소 (로컬 개발: localhost, Gmail: smtp.gmail.com)
SMTP_SERVER=localhost

# SMTP 서버 포트
# - 25: 로컬 개발용 (비암호화)
# - 587: TLS (운영 환경 권장)
# - 465: SSL
SMTP_PORT=25

# SMTP 인증 사용자명 (일반적으로 이메일 주소)
SMTP_USERNAME=your-email@example.com

# SMTP 인증 비밀번호
# Gmail의 경우 앱 비밀번호 사용 필요 (2단계 인증 활성화 후 생성)
SMTP_PASSWORD=your-app-password

# 발신자 이메일 주소 (미설정 시 SMTP_USERNAME 사용)
# SMTP_FROM_EMAIL=noreply@example.com

# 발신자 이름 (미설정 시 PROJECT_NAME 사용)
# SMTP_FROM_NAME=FastAPI Project

# TLS 사용 여부 (포트 587 사용 시 true)
SMTP_TLS=false

# SSL 사용 여부 (포트 465 사용 시 true)
SMTP_SSL=false

# =============================================================================
# 이미지 업로드 설정
# config.UploadSettings 로 로드됨. 업로드 핸들러는 아직 없다 —
# 구현 시 `from config import upload_settings` 로 사용한다.
# =============================================================================
# 업로드된 이미지 자동 리사이즈 활성화
UPLOAD_IMAGE_RESIZE=false

# 업로드 이미지 최대 크기 (MB)
UPLOAD_IMAGE_SIZE_LIMIT=20

# 리사이즈 최대 너비 (px, UPLOAD_IMAGE_RESIZE=true 시 적용)
UPLOAD_IMAGE_RESIZE_WIDTH=1200

# 리사이즈 최대 높이 (px, UPLOAD_IMAGE_RESIZE=true 시 적용)
UPLOAD_IMAGE_RESIZE_HEIGHT=2800

# 이미지 압축 품질 (0-100, 기본값: 85)
# 값이 높을수록 품질은 좋지만 파일 크기 증가
UPLOAD_IMAGE_QUALITY=85

# 허용되는 이미지 확장자 (JSON 배열 형식)
# UPLOAD_ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".webp"]

# 업로드 파일 저장 경로 (프로젝트 루트 기준 상대 경로)
UPLOAD_DIR=uploads
